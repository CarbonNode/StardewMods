<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10</LangVersion>
    <AssemblyName>SharedDay</AssemblyName>
    <RootNamespace>SharedDay.Mod</RootNamespace>
    <Version>0.1.43</Version>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableHarmony>true</EnableHarmony>
    <EnableModZip>true</EnableModZip>
    <ModFolderName>SharedDay</ModFolderName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
    <ProjectReference Include="../SharedDay.Core/SharedDay.Core.csproj" />
  </ItemGroup>
</Project>
